{
  "name": "shebao-code",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "SB_KV",
      "id": "8d2aa69ce7174e388934f775bd7739fa"
    }
  ],
  "observability": {
    "enabled": true
  }
}
